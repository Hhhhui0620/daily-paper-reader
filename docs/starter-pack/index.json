{"version": 1, "packs": [{"run_id": "20260921-e959361397be", "tag": "uav-rgbt-sod", "status": "content_pending", "paper_count": 23, "as_of": "2026-09-21", "updated_at": "2026-09-21T02:03:51.422180+00:00", "mode": "starter", "result_count": 23, "content_done": 2, "content_pending": 21, "guide_status": "complete", "export_path": "docs/starter-pack/20260921-e959361397be/papers.md", "selected_records": [{"id": "arxiv:2512.21856", "title": "Breaking Alignment Barriers: TPS-Driven Semantic Correlation Learning for Alignment-Free RGB-T Salient Object Detection", "score": 9, "route": "20250921-20260920/2512.21856v1", "published": "2025-12-26", "publication_date": "2025-12-26", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2512.21856v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "现有RGB-T显著目标检测方法依赖人工对齐标注数据，难以应对真实场景中空间错位、尺度变化和视角偏移等跨模态差异。本文提出TPS-SCL网络，以双流MobileViT为编码器并结合Mamba扫描机制，通过薄板样条对齐模块与语义相关性约束模块实现无对齐RGB-T检测。实验表明该方法在轻量级SOD方法中达到SOTA，并优于主流RGB-T方法。", "tags": [], "reading_status": "complete"}, {"id": "work:7a40d7631a0f7390060d9b42", "title": "Alignment-Free RGB-T Salient Object Detection: A Large-Scale Dataset and Progressive Correlation Network", "score": 9, "route": "conference/aaai-2025/aaai-2025-32838-alignment-free-rgb-t-salient-object-detection-a-large-scale-dataset-and-progressive-correlation-network", "published": "2025", "publication_date": "2025", "publication_date_precision": "year", "publication_date_source": "conference year only; exact release date unverified", "publication_date_kind": "unknown", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2605.20667", "title": "LER-YOLO: Reliability-Aware Expert Routing for Misaligned RGB-Infrared UAV Detection", "score": 9, "route": "20250921-20260920/2605.20667v1", "published": "2026-05-20", "publication_date": "2026-05-20", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2605.20667v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "RGB-红外无人机检测面临目标小、背景杂、跨传感器空间错位等难题，现有双模态检测器在融合前不评估局部对应可靠性，导致错位伪影传入检测头。LER-YOLO提出可靠性感知稀疏专家混合框架：先用不确定性感知目标对齐模块将可见光特征重采样至红外参考并估计空间可靠性图，再据此从RGB主导、红外主导与交互融合专家中自适应选k个专家。在MBU基准上三次独立种子取得89.7±0.2% AP50，最佳89.9%，消融与参数匹配对比表明增益主要来自可靠性引导的专家路由而非模型容量。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2609.12622", "title": "RA-SOD: Reliability-Aware RGB-T Salient Object Detection under Modality Degradation", "score": 7, "route": "20250921-20260920/2609.12622v1", "published": "2026-09-11", "publication_date": "2026-09-11", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.12622v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2604.26893", "title": "Graph-based Semantic Calibration Network for Unaligned UAV RGBT Image Semantic Segmentation and A Large-scale Benchmark", "score": 7, "route": "20250921-20260920/2604.26893v2", "published": "2026-04-29", "publication_date": "2026-04-29", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2604.26893v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2603.12685", "title": "RSONet: Region-guided Selective Optimization Network for RGB-T Salient Object Detection", "score": 7, "route": "20250921-20260920/2603.12685v1", "published": "2026-03-13", "publication_date": "2026-03-13", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2603.12685v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2608.27971", "title": "GAAT: Geometry-Aware Alignment Transformer for Multimodal UAV Perception", "score": 7, "route": "20250921-20260920/2608.27971v2", "published": "2026-08-28